<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Mishkefet does no tracking and collects no data. Photos are read on the device only, the
	  handwriting samples and the fine-tuned model stay on the device, and the app makes no network
	  requests. UserDefaults stores the app's own settings (training rounds, which model to use).
	  https://developer.apple.com/documentation/bundleresources/describing-use-of-required-reason-api
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read and write only data accessible to this app (its settings). -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
